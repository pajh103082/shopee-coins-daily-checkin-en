{
  "manifest_version": 3,
  "name": "Shopee Coins Daily Check-in (Taiwan)",
  "version": "1.7.2",
  "description": "Checks in on the Shopee Taiwan coins page every day, retries if it fails, and logs back in with Google when you are logged out.",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "contentSettings",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "https://shopee.tw/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shopee Daily Check-in",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
